# --- Azure Face API ---
AZURE_FACE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_FACE_KEY=your-azure-key
AZURE_TIMEOUT=10

# --- Stockage (optionnel, valeurs par défaut sous backend/data) ---
# DATA_DIR=
# DB_PATH=
# REFERENCES_DIR=

# --- Reconnaissance ---
HEADPOSE_PITCH_MAX=15
HEADPOSE_YAW_MAX=15
DEEPFACE_MODEL=VGG-Face

# --- Action déclenchée à la reconnaissance ---
# none | log | command | webhook
RECOGNITION_ACTION=log
# Pour RECOGNITION_ACTION=command (variables disponibles: {name} {confidence})
# Exemple Linux/macOS : notify-send "Reconnu" "{name}"
# Exemple Windows     : notepad.exe
RECOGNITION_COMMAND=
# Pour RECOGNITION_ACTION=webhook
RECOGNITION_WEBHOOK_URL=

# --- Sécurité / API ---
# Laisser vide pour désactiver l'authentification
API_KEY=
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000
