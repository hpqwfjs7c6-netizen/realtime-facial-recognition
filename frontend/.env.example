# URL du backend FastAPI
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Clé API (doit correspondre à API_KEY du backend ; laisser vide si désactivée).
# ATTENTION : toute variable NEXT_PUBLIC_* est intégrée au bundle navigateur et
# donc LISIBLE par le client — ce n'est PAS un secret. Elle limite l'accès aux
# clients que vous contrôlez, mais ne remplace pas une vraie authentification
# utilisateur (OAuth/JWT) côté backend pour des données sensibles.
NEXT_PUBLIC_API_KEY=
